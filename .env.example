# ── Core Infrastructure (Free Tier Supported) ─────────────────────────────
# Supabase ($0 Free tier supported: 500MB DB, 5GB bandwidth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini AI ($0 Free tier rate limits: 15 RPM; paid tier recommended for production)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite-preview,gemini-3-flash-preview

# Site URL for OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional Enterprise Scale Seams (Zero-Cost Fallbacks Active by Default) ─
# Upstash Redis (Phase 4: Optional distributed cache & multi-instance rate limiter; fallback is in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Jitsi / JaaS Teleconsultations (Phase 3: Optional cryptographic HS256/RS256 JWT; fallback is time-gated access)
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_APP_SECRET=
JAAS_API_KEY=

# ABDM Gateway Integration (Phase 3: Optional live NHA Sandbox API credentials; fallback is simulated validation)
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# Bhashini Speech & Translation (Phase 3: Optional GoI ULCA Voice API; fallback is client-side Web Speech API)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ── Testing & Staging Harness ───────────────────────────────────────────────
LOADTEST_ENABLED=false
LOADTEST_KEY=your-staging-loadtest-secret

# Doctor claim token salt — MUST be set in production. Keep this secret.
# Generate a strong random value: openssl rand -hex 32
DOCTOR_CLAIM_SECRET=

# E2E Test Credentials (used in Playwright tests)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_DOCTOR_EMAIL=
E2E_DOCTOR_PASSWORD=
E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=

