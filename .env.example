# Public browser configuration; never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets: configure through an ignored local file/host secret manager.
SUPABASE_SERVICE_ROLE_KEY=
ASSISTANT_CONFIRMATION_SECRET=

# Optional external AI; provider quotas/model availability can change.
GEMINI_API_KEY=
GEMINI_MODELS=

# Optional shared Redis; absent configuration uses process-local limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Conferencing provider: validate real access/signing before deployment.
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_APP_SECRET=
JAAS_API_KEY=

# Owned inference: optional, no runtime model downloads. Not a browser origin.
# Loopback works only on the same host as Next.js; remote requires HTTPS/token.
VOICE_SERVICE_URL=
VOICE_SERVICE_TOKEN=

# Staging harness only; disabled by default.
LOADTEST_ENABLED=false
LOADTEST_KEY=

# Disposable E2E account credentials; do not use production accounts.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_DOCTOR_EMAIL=
E2E_DOCTOR_PASSWORD=
E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=

# ABDM/Bhashini live integrations and trusted clinician invite issuance are
# not implemented by this configuration. No secret activates a browser stub.
