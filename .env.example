# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini AI (Server-side only — never expose to client)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# Optional: Upstash Redis (for distributed rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Override site URL for OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E2E Test Credentials (used in Playwright tests)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_DOCTOR_EMAIL=
E2E_DOCTOR_PASSWORD=
E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=
